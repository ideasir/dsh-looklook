# dsh-looklook build-time npm settings.
# DSH rc.6 client packages declare peer react@^18.2.0 while this plugin's own
# dev toolchain targets react@^19. DSH installs git-hosted plugins by running
# `npm install` in a temp dir during the prepare script; without this flag npm
# strictly rejects the peer conflict and the install fails. Runtime resolution
# is unaffected — the plugin ships a prebuilt client bundle.
legacy-peer-deps=true